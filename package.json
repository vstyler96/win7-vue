{
  "name": "win7-vue",
  "version": "3.0.0",
  "main": "dist/win7-vue.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vstyler96/7.css": "^2.0.0",
    "@vstyler96/98.css": "^2.0.0",
    "@vstyler96/system.css": "^2.0.0",
    "@vstyler96/x.css": "^2.0.0",
    "@vstyler96/xp.css": "^2.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "highlight.js": "^11.11.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.27",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.2.4"
  },
  "peerDependencies": {
    "@vstyler96/7.css": "^2.0.0",
    "@vstyler96/98.css": "^2.0.0",
    "@vstyler96/system.css": "^2.0.0",
    "@vstyler96/x.css": "^2.0.0",
    "@vstyler96/xp.css": "^2.0.0",
    "vue": "^3.5.18",
    "vue-router": ">=4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/win7-vue.js"
    },
    "./global": {
      "types": "./dist/global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "description": "Agnostic Vue 3 component library for classic Windows & Mac OS UI — real 98.css / XP.css / 7.css / system.css markup, zero shipped CSS, runtime theme switching",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/vstyler96/win7-vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vstyler96/win7-vue.git"
  },
  "keywords": [
    "windows7",
    "windowsxp",
    "windows98",
    "vue",
    "vuejs",
    "js",
    "library",
    "components",
    "vue3",
    "frutiger",
    "7.css",
    "xp.css",
    "98.css",
    "aero",
    "system.css",
    "macos",
    "osx",
    "aqua",
    "x.css"
  ],
  "peerDependenciesMeta": {
    "@vstyler96/7.css": {
      "optional": true
    },
    "@vstyler96/98.css": {
      "optional": true
    },
    "@vstyler96/system.css": {
      "optional": true
    },
    "@vstyler96/x.css": {
      "optional": true
    },
    "@vstyler96/xp.css": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "private": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "dev:forks": "vite --config vite.config.demo.ts --mode forks",
    "build": "vue-tsc -b ./tsconfig.lib.json && vite build",
    "prepublishOnly": "npm run build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview:demo": "vite preview --outDir demo",
    "typecheck": "vue-tsc -b",
    "lint": "eslint ."
  },
  "type": "module",
  "types": "dist/main.d.ts",
  "config": {
    "cz-conventional-kawaii": {
      "scopes": [
        "catalog",
        "style",
        "demo page",
        "infrastructure"
      ],
      "types": {
        "feat": {
          "emoji": ":sparkles:",
          "description": "✨) feat            A new feature"
        },
        "fix": {
          "emoji": ":wrench:",
          "description": "🔧) fix             Code fixes in the application"
        },
        "wip": {
          "emoji": ":construction:",
          "description": "🚧) wip             Work in progress commit"
        },
        "chore": {
          "emoji": ":card_index_dividers:",
          "description": "🗂️) chore           Not affecting code or tests"
        },
        "performance": {
          "emoji": ":rocket:",
          "description": "🚀) performance     Performance improvenment"
        },
        "docs": {
          "emoji": ":page_facing_up:",
          "description": "📄) docs            Updated documentation"
        },
        "refactor": {
          "emoji": ":hammer_and_wrench:",
          "description": "🛠️) refactor        Code refactor or significant changes"
        },
        "security": {
          "emoji": ":shield:",
          "description": "🛡️) security        Security updates"
        },
        "automation": {
          "emoji": ":package:",
          "description": "📦) automation      Packaging or automation updates"
        }
      }
    }
  }
}
